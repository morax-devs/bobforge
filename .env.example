# ==============================================================================
# BobForge Model Provider Configuration
# Copy this file to .env and configure your preferred provider.
# ==============================================================================

# Option 1: Groq (FREE, ultra-fast generation - get key at console.groq.com)
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: IBM watsonx.ai (Recommended for IBM Hackathon)
# IBM_WATSONX_API_KEY=your_ibm_cloud_api_key_here
# IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here
# IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
# IBM_WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Option 3: Anthropic
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option 4: OpenAI
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Option 5: Local Ollama (Zero cost, runs on your machine)
# OLLAMA_BASE_URL=http://localhost:11434/v1/chat/completions
# OLLAMA_MODEL=qwen2.5-coder:latest
